# Aasirbad — copy to backend/.env (never commit real values)
APP_ENV=development            # development | staging | production
DEBUG=true                     # must be false in production
SECRET_KEY=change-me-in-production-use-32+-random-chars
JWT_SECRET_KEY=jwt-secret-change-in-production-use-32+-random-chars
BACKEND_CORS_ORIGINS=http://localhost:3000

# Database (Postgres is the real DB; DB_BACKEND=sqlite is for tests only)
DB_BACKEND=postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aasirbad
POSTGRES_PASSWORD=aasirbad_secret
POSTGRES_DB=aasirbad

# Voice cloning provider: "demo" works offline with placeholder audio (NOT a real clone);
# "elevenlabs" gives real cloning and needs a key.
TTS_PROVIDER=demo
ELEVENLABS_API_KEY=

# Training runs inside the API process by default. "celery" needs Redis + a worker.
TASK_MODE=inline
REDIS_HOST=localhost

# Storage (local disk by default)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage

# Free tier limits (per user)
MAX_PROFILES_PER_USER=3
MONTHLY_SYNTHESIS_CHARS=5000

# Password-reset emails (optional; without SMTP the link is printed to the server log in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@aasirbad.local
